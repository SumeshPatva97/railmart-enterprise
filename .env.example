# Environment Variables Configuration
NEXT_PUBLIC_APP_NAME="RailMart Enterprise"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Connection (PostgreSQL or SQLite fallback for development)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/railmart_db?schema=public"

# Authentication & Security Secrets
JWT_SECRET="railmart_super_secret_jwt_key_2026_change_in_production"
JWT_REFRESH_SECRET="railmart_refresh_token_secret_key_2026"
COOKIE_DOMAIN="localhost"

# Payment Gateways Configuration
RAZORPAY_KEY_ID="rzp_test_railmart_key_id"
RAZORPAY_KEY_SECRET="rzp_test_railmart_secret_key"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_railmart_key_id"

STRIPE_SECRET_KEY="sk_test_railmart_stripe_secret"
STRIPE_WEBHOOK_SECRET="whsec_railmart_stripe_webhook_secret"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_railmart_stripe_pub"

# Nodemailer / SMTP Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="notifications@railmart.com"
SMTP_PASS="your_app_password_here"
EMAIL_FROM="RailMart Orders <orders@railmart.com>"

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME="railmart-cloud"
CLOUDINARY_API_KEY="1234567890"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
